# AI Design Council - environment configuration
# Copy this file to .env and fill in real values. Never commit .env with real secrets.
# V0 ships and is fully tested with --provider mock, which needs NONE of these.

# --- OpenAI adapter (skeleton, not required for V0 mock tests) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# --- Anthropic / Claude adapter (skeleton, not required for V0 mock tests) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Ollama adapter (skeleton, not required for V0 mock tests) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- General ---
# Directory where run artifacts are written (default: ./runs)
COUNCIL_RUNS_DIR=runs
